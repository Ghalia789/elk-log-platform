{
  "index_patterns": ["logs-saas-*"],
  "priority": 200,
  "data_stream": {},
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "level": {
          "type": "keyword"
        },
        "service": {
          "type": "keyword"
        },
        "endpoint": {
          "type": "keyword"
        },
        "http_method": {
          "type": "keyword"
        },
        "status_code": {
          "type": "short"
        },
        "response_time_ms": {
          "type": "float"
        },
        "client_ip": {
          "type": "ip"
        },
        "user_id": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "upload_id": {
          "type": "keyword"
        },
        "source_file": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "message": {
          "type": "text",
          "fields": {
            "raw": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        }
      }
    }
  }
}
