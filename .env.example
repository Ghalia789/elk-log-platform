# Copy to .env and adjust. Never commit .env.
ELK_VERSION=8.15.3
ES_HOST=http://elasticsearch:9200
MONGO_URI=mongodb://mongodb:27017/logs
MONGO_ROOT_USERNAME=loglens_admin
MONGO_ROOT_PASSWORD=change-me-in-local-env
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=50
SEARCH_CACHE_TTL=60
STATS_CACHE_TTL=15
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Module G (alerting)
ALERT_INTERVAL_SEC=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WEBHOOK_URL=
