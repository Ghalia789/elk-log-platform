# Copy to .env and replace local placeholder values. Never commit .env.
ELK_VERSION=8.15.3
ES_HOST=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Atlas is the default. Replace the placeholders with your Atlas values locally.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/loglens
MONGO_DB=loglens
# Only used with: docker compose --profile local-mongo up
MONGO_ROOT_USER=loglens_admin
MONGO_ROOT_PASSWORD=replace-with-a-local-password
REDIS_URL=redis://redis:6379/0
FLASK_ENV=development
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=100
